# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Elastic Beanstalk artifacts (generated by eb cli)
.elasticbeanstalk/

# Data files (uploaded CSVs – not part of source)
data/*.csv
data/*.json

# Node (package-lock.json exists in backend root – EB should ignore it)
node_modules/
package-lock.json

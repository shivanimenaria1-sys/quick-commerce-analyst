packages:
  yum:
    # WeasyPrint requires Cairo + Pango for PDF rendering on Amazon Linux 2023
    cairo:         []
    pango:         []
    libffi-devel:  []
    # Pillow / image support
    libjpeg-turbo-devel: []
    # Build tools (needed for some pip packages that compile C extensions)
    gcc:           []
    python3-devel: []

commands:
  # Ensure pip is up to date before installing requirements
  upgrade_pip:
    command: "/usr/bin/python3 -m pip install --upgrade pip"
    ignoreErrors: false
